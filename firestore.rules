rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isMe(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Super admin dibaca dari community_config/v1.super_admin_email
    function isSuperAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/community_config/v1) &&
        get(/databases/$(database)/documents/community_config/v1)
          .data.super_admin_email == request.auth.token.email;
    }

    // Admin = super admin ATAU ada di admin_emails
    function isAdmin() {
      return isSuperAdmin() ||
        (isAuth() &&
         exists(/databases/$(database)/documents/community_config/v1) &&
         get(/databases/$(database)/documents/community_config/v1)
           .data.admin_emails.hasAny([request.auth.token.email]));
    }

    function isModerator() {
      return isAdmin() ||
        (isAuth() &&
         exists(/databases/$(database)/documents/community_config/v1) &&
         get(/databases/$(database)/documents/community_config/v1)
           .data.moderator_emails.hasAny([request.auth.token.email]));
    }

    // ─── users/{userId} ───────────────────────────────────────────────────────
    // Profil publik antar user yang login. Hanya pemilik atau admin yang bisa edit.
    // Pengecualian: buy flow perlu update total_poin + soldNfts milik counterparty.
    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isMe(userId);
      // badge_kontributor & total_kontribusi WAJIB admin-only — isMe(userId) di bawah
      // sengaja dikecualikan dari kedua field ini (hasAny) agar user tidak bisa
      // memberi badge/nilai kontribusi ke diri sendiri lewat write biasa.
      allow update: if
        (isMe(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['badge_kontributor', 'total_kontribusi'])) ||
        isAdmin() ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['soldNfts', 'totalLikes', 'total_poin', 'total_poin_pending', 'buybackCount', 'level', 'pending_seller_actions', 'pending_buyback_actions', 'daily_usage'])) ||
        // Validasi flow: pemilik akun mencatat partisipasi validasi
        (isMe(userId) &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['validator_aktif']));
      allow delete: if isAdmin();

      // neraca_log/{logId} — log transaksi per user, immutable setelah dibuat
      match /neraca_log/{logId} {
        allow read:           if isMe(userId) || isAdmin();
        allow create:         if isAuth();
        allow update, delete: if isAdmin();
      }
    }

    // ─── nfts/{nftId} ─────────────────────────────────────────────────────────
    // Baca: publik (marketplace terbuka).
    // Tulis: pemilik aset atau admin.
    match /nfts/{nftId} {
      allow read:   if true;
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.owner    == request.auth.uid ||
        // Buy flow: siapapun yang auth boleh ambil NFT forSale, tapi hanya field owner+forSale
        (resource.data.forSale == true &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'forSale'])) ||
        // Like flow: siapapun yang auth boleh update field likes saja
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) ||
        isAdmin()
      );
      allow delete: if isAdmin() ||
        (isAuth() && resource.data.createdBy == request.auth.uid &&
         request.time < resource.data.createdAt + duration.value(30, "m"));

      // votes/{userId} — 1 vote per user, bisa diupdate (ubah pilihan)
      match /votes/{voterId} {
        allow read:          if isAuth();
        allow create, update: if isMe(voterId);
        allow delete:        if isAdmin();
      }

      // likes/{userId} — 1 like per user, tidak bisa diubah, hanya create/delete
      match /likes/{likerId} {
        allow read:   if true;
        allow create: if isMe(likerId);
        allow delete: if isMe(likerId) || isAdmin();
        allow update: if false;
      }
    }

    // ─── transactions/{txId} ─────────────────────────────────────────────────
    // Rekaman permanen. Hanya buyer/seller yang bisa baca transaksi mereka.
    // Tidak bisa diupdate/dihapus (immutable) kecuali admin.
    match /transactions/{txId} {
      allow read: if isAuth() && (
        resource.data.buyerId  == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create:        if (isAuth() && request.resource.data.buyerId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── buybackRequests/{requestId} — legacy, tidak digunakan ──────────────
    match /buybackRequests/{requestId} {
      allow read: if isAuth() && (
        resource.data.buyerId  == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.vendorId == request.auth.uid ||
        resource.data.buyerId  == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── user_blocks/{blockId} — personal blocklist ──────────────────────────────
    match /user_blocks/{blockId} {
      allow read: if isAuth() && (
        resource.data.blocker_id == request.auth.uid ||
        resource.data.blocked_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() &&
        request.resource.data.blocker_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAuth() &&
        resource.data.blocker_id == request.auth.uid;
    }

    // ─── purchase_disputes/{disputeId} — laporan transaksi mencurigakan ────────
    match /purchase_disputes/{disputeId} {
      allow read: if isAuth() && (
        resource.data.seller_id == request.auth.uid ||
        resource.data.buyer_id  == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── buyback_requests/{requestId} — Fase 2B two-way handshake ────────────
    // Pembeli (requester) buat request, seller konfirmasi/tolak, pembeli selesaikan.
    match /buyback_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.requester_id == request.auth.uid ||
        resource.data.seller_id    == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() &&
        request.resource.data.requester_id == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.seller_id    == request.auth.uid ||
        resource.data.requester_id == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ─── reports/{reportId} ───────────────────────────────────────────────────
    // User bisa membuat laporan, hanya admin yang bisa membaca dan mengelola.
    match /reports/{reportId} {
      allow read:          if isAdmin();
      allow create:        if isAuth();
      allow update, delete: if isAdmin();
    }

    // ─── topDevelopers/{developerId} ─────────────────────────────────────────
    // Leaderboard publik. Ditulis oleh Cloud Functions / Admin SDK saja.
    match /topDevelopers/{developerId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─── community_config/{docId} ────────────────────────────────────────────
    // Kontrak sosial komunitas — publik untuk dibaca (halaman /parameters).
    // Create: siapa pun yang login bisa buat doc awal (bootstrap fresh deploy).
    // Update/Delete: hanya super admin atau admin.
    match /community_config/{docId} {
      allow read:   if true;
      allow create: if isAuth();
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    // ─── projects/{projectId} ────────────────────────────────────────────────
    // Daftar project charity. Publik untuk dibaca.
    // Create: developer yang login, developer_id harus cocok dengan uid-nya.
    // Update: developer pemilik project atau admin.
    // Delete: tidak diizinkan (project adalah rekaman permanen).
    match /projects/{projectId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.developer_id == request.auth.uid;
      allow update: if isAdmin() ||
        (isAuth() && resource.data.developer_id == request.auth.uid) ||
        // Soft delete oleh admin: hanya set status, deleted_at, deleted_by
        (isAdmin() &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['status', 'deleted_at', 'deleted_by'])) ||
        // Validasi flow: siapapun yang login bisa tambah jaminan ke project
        (isAuth() &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'pool_jaminan',
              'jumlah_validator',
              'validator_list'
            ])) ||
        // Link checker: siapapun yang login bisa update status link bukti
        (isAuth() &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'link_bukti_status',
              'link_bukti_last_checked'
            ]));
      allow delete: if false;
    }

    // ─── nft_units/{nftUnitId} ───────────────────────────────────────────────
    // Satuan NFT yang diperjualbelikan. Publik untuk dibaca.
    // Create: hanya oleh developer yang membuat project (developer_id & owner_id = uid).
    // Update: pemilik saat ini (owner) ATAU developer asal (untuk edit gambar/metadata).
    // Delete: tidak diizinkan (unit adalah rekaman permanen).
    match /nft_units/{nftUnitId} {
      allow read:   if true;
      allow create: if (isAuth() &&
          request.resource.data.developer_id == request.auth.uid &&
          request.resource.data.owner_id == request.auth.uid) ||
        // Infrastructure certificates: diterbitkan oleh siapapun yang auth (dipicu fee event)
        (isAuth() && request.resource.data.is_infrastructure == true);
      allow update: if isAdmin() ||
        (isAuth() && resource.data.owner_id == request.auth.uid) ||
        (isAuth() && resource.data.developer_id == request.auth.uid) ||
        // Buy flow: siapapun yang auth boleh ambil NFT for_sale (in_pool opsional untuk beli_pool)
        (isAuth() && resource.data.for_sale == true &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['owner_id', 'for_sale', 'harga_beli_terakhir', 'in_pool', 'purchased_at', 'purchase_status', 'purchase_auto_complete_at', 'purchase_confirmed_at', 'purchased_from'])) ||
        // Purchase confirmation flow: developer konfirmasi atau auto-complete
        (isAuth() &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['purchase_status', 'purchase_confirmed_at'])) ||
        // Comment flow: siapapun yang auth boleh update comment_count saja
        (isAuth() && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['comment_count'])) ||
        // Like flow: siapapun yang auth boleh update like_count saja
        (isAuth() && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['like_count'])) ||
        // Validasi flow: owner menyerahkan NFT ke pool jaminan project
        (isAuth() &&
          request.auth.uid == resource.data.owner_id &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'digunakan_validasi',
              'project_validasi_id',
              'harga_beli_terakhir',
              'nilai_selisih',
              'for_sale',
              'harga_beli_sebelum_validasi',
              'nilai_selisih_sebelum_validasi',
              'pernah_digunakan_validasi'
            ])) ||
        // Transfer pool flow: tambah transferred_at saat masuk pool
        (isAuth() &&
          request.auth.uid == resource.data.owner_id &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['in_pool', 'for_sale', 'transferred_at'])) ||
        // FIFO skip: top developer melewati antrian, transferred_at di-reset agar geser ke belakang
        (isAuth() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.level == 'top_developer' &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'fifo_skip_count',
              'last_skipped_by',
              'last_skip_reason',
              'transferred_at'
            ]));
      allow delete: if false;

      // history_kepemilikan/{historyId} — rekaman perpindahan tangan, publik & immutable
      match /history_kepemilikan/{historyId} {
        allow read:           if true;
        allow create:         if isAuth();
        allow update, delete: if isAdmin();
      }

      // likes/{likeId} — 1 like per user, tidak bisa diubah, hanya create/delete
      match /likes/{likeId} {
        allow read: if true;
        allow create: if isAuth() && request.resource.data.user_id == request.auth.uid;
        allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
        allow update: if false;
      }

      // comments/{commentId} — komentar flat per NFT unit, Fase 1
      match /comments/{commentId} {
        allow read:   if true;
        allow create: if isAuth() &&
          request.resource.data.user_id == request.auth.uid &&
          request.resource.data.text.size() <= 500;
        allow update: if (isAuth() &&
            request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['anomali_flag']))
          || (isAuth() &&
              request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['is_pinned']))
          || isMe(resource.data.user_id)
          || isAdmin();
        allow delete: if isMe(resource.data.user_id) || isAdmin();
      }
    }

    // ─── pool_rekomendasi/{docId} ─────────────────────────────────────────────
    // Metadata pool rekomendasi komunitas. Publik untuk dibaca.
    // Write: semua user yang login (top developer melakukan upsert via transferToPool).
    match /pool_rekomendasi/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ─── fee_pool/{docId} ─────────────────────────────────────────────────────
    // Akumulasi fee sharing komunitas. Publik untuk dibaca (halaman /parameters).
    // Write: semua user yang login (maybeTriggerFee melakukan upsert).
    match /fee_pool/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ─── contributor_certificates/{certId} ───────────────────────────────────
    // Rekaman publik kontributor infrastruktur. Dibuat saat pembelian Infrastructure Certificate.
    match /contributor_certificates/{certId} {
      allow read:           if true;
      allow create:         if isAuth();
      allow update, delete: if isAdmin();
    }

    // ─── daily_stats/{date} ──────────────────────────────────────────────────
    // Counter harian global untuk rate limiting (project & komentar).
    // Dibatasi ketat: hanya dua field yang diizinkan untuk mencegah penyalahgunaan.
    match /daily_stats/{date} {
      allow read: if true;
      allow write: if isAuth() &&
        request.resource.data.keys().hasOnly(['projects', 'comments']);
    }

    // ─── infrastructure_payments/{paymentId} ─────────────────────────────────
    // Riwayat reward ke kontributor infrastruktur. Publik untuk transparansi.
    // Write: hanya admin (verifikasi reward dilakukan manual oleh admin).
    match /infrastructure_payments/{paymentId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ─── infrastructure_claims/{claimId} ─────────────────────────────────────
    // User mengklaim sudah membayar infrastruktur nyata; admin verifikasi.
    // Publik untuk dibaca (transparansi). Create: hanya pemilik klaim, status
    // awal wajib 'pending', bukti_link wajib http(s). Guard "1 klaim pending
    // per user" TIDAK ditegakkan di rules (tidak ada query arbitrer di rules
    // security language) — diperiksa client-side sebelum submit; verifikasi
    // admin tetap jadi gerbang keras jika guard client terlewati.
    match /infrastructure_claims/{claimId} {
      allow read: if true;
      allow create: if isAuth() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.nilai is number && request.resource.data.nilai > 0 &&
        request.resource.data.bukti_link is string &&
        request.resource.data.bukti_link.matches('^https?://.+') &&
        request.resource.data.keys().hasOnly(
          ['user_id', 'user_nama', 'nilai', 'bukti_link', 'keterangan', 'status', 'created_at']);
      allow update, delete: if isAdmin();
    }

    // ─── ai_reviews/{reviewId} ───────────────────────────────────────────────
    // Review AI governance — transparan publik, hanya admin yang bisa tulis.
    // Tidak ada hasOnly() pada create/update karena struktur entries bersarang
    // dan hanya admin yang diberi akses — kepercayaan diberikan ke peran, bukan field.
    match /ai_reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ─── recalculate_requests/{docId} ────────────────────────────────────────
    // Flag untuk memicu recalculate developer levels via GitHub Actions cron.
    // Sengaja terbuka untuk write tanpa auth (dipakai dari API route server-side).
    // Dibatasi ketat: hanya docId='flag', hanya field requested_at.
    match /recalculate_requests/{docId} {
      allow read: if true;
      allow write: if docId == 'flag' &&
        request.resource.data.keys().hasOnly(['requested_at']);
    }

    // ─── collectionGroup: neraca_log ─────────────────────────────────────────
    // Diperlukan agar halaman /transactions bisa query semua log lintas user.
    // Sesuai prinsip transparansi TMEP: semua user yang login bisa melihat
    // semua log transaksi komunitas.
    match /{path=**}/neraca_log/{logId} {
      allow read: if isAuth();
    }

    // ─── collectionGroup: comments ───────────────────────────────────────────
    // Rule path spesifik di nft_units/.../comments tidak mencakup collectionGroup
    // query. Wildcard ini diperlukan agar /admin/reports bisa fetch semua
    // komentar terflag lintas seluruh nft_units.
    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }
  }
}
