# Super Admin Email (wajib diisi)
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=your-admin@email.com

# Firebase Config (wajib diisi)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Secret untuk endpoint recalculate otomatis (opsional, untuk Lapis 2 cron)
# Samakan nilai ini dengan GitHub Secret RECALC_SECRET di repo Anda
RECALC_SECRET=

# Secret untuk endpoint AI Review otonom (opsional, untuk AI Level 2)
# Samakan nilai ini dengan GitHub Secret AI_REVIEW_SECRET di repo Anda
AI_REVIEW_SECRET=

# Secret untuk endpoint Info Inflasi/Deflasi otonom (opsional, cron tahunan)
# Samakan nilai ini dengan GitHub Secret INFLATION_AUTO_SECRET di repo Anda
INFLATION_AUTO_SECRET=

# Google AI (Gemini) API key — diperlukan untuk mode AI Review otonom Level 2
# Buat di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai (opsional, default: googleai/gemini-3.6-flash)
# Format: googleai/[nama-model]. Rantai fallback lengkap: src/lib/ai-models.ts.
# Model yang tersedia berbeda-beda per project Google (grandfathered vs baru).
# Kalau default/rantai fallback gagal untuk API key Anda, verifikasi model
# mana yang benar-benar bisa dipanggil dengan:
#   npx tsx scripts/check-gemini-models.ts
# lalu isi di sini untuk override rantai (diprioritaskan di depan fallback).
GEMINI_MODEL=

# Firebase Admin SDK service account — diperlukan untuk mode AI Review otonom Level 2
# Cara mendapatkan: Firebase console → Project Settings → Service Accounts → Generate new private key
# Encode ke base64: cat service-account.json | base64 (Linux/Mac) atau [Convert]::ToBase64String([IO.File]::ReadAllBytes('service-account.json')) (PowerShell)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Set true hanya untuk development dengan Firebase Emulator lokal. Production: false atau hapus.
NEXT_PUBLIC_USE_EMULATOR=false
